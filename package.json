{
  "name": "treenote",
  "version": "1.0.4",
  "desktopName": "com.treenote.app",
  "description": "Hierarchical notes management application",
  "author": "Alexey Ryazhskikh",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^40.10.5",
    "electron-builder": "^27.0.0-alpha.5",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.4",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
